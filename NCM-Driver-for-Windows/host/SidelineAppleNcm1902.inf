; Apple USB NCM composite-parent driver for 05AC:1902. Build template.
; Derived from Microsoft NCM sample; upstream copyright/license retained in source.
[Version]
Signature="$WINDOWS NT$"
Class=Net
ClassGUID={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=SidelineAppleNcm1902.cat
DriverVer=; populated by StampInf during build
PnpLockdown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...26100

[Models.NTamd64.10.0...26100]
%DeviceDesc%=Apple1902,USB\VID_05AC&PID_1902

[Apple1902.NT]
AddReg=Apple1902_AddReg
CopyFiles=Drivers_Dir
BusType=15
Characteristics=0x84
*IfType=6
*MediaType=0
*PhysicalMediaType=0
*IfConnectorPresent=1
*ConnectionType=1
*DirectionType=0
*AccessType=2
*HardwareLoopback=0

[Apple1902.NT.Services]
AddService=SidelineAppleNcm1902,0x00000002,Apple1902_Service

[Apple1902_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SidelineAppleNcm1902.sys

[Apple1902.NT.Wdf]
KmdfService=SidelineAppleNcm1902,Apple1902_Wdf

[Apple1902_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Apple1902_AddReg]
HKR,Ndi,Service,0,"SidelineAppleNcm1902"
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"ethernet"

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
SidelineAppleNcm1902.sys=1,,

[Drivers_Dir]
SidelineAppleNcm1902.sys

[Strings]
ProviderName="Sideline"
DeviceDesc="Apple USB NCM Network Adapter"
ServiceDesc="Apple USB NCM Driver"
DiskName="Apple USB NCM Driver Package"
